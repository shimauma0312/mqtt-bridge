{
    "name": "shimauma0312/mqtt-bridge",
    "description": "MQTT to Redis/RDB bridge worker",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "MqttBridge\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MqttBridge\\Tests\\": "tests/" }
    },
    "config": {
        "platform-check": false
    }
}
