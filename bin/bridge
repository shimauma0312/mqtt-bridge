#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

$config = [
    'mqtt' => [
        'host'       => getenv('MQTT_HOST') ?: '127.0.0.1',
        'port'       => (int) (getenv('MQTT_PORT') ?: 1883),
        'client_id'  => getenv('MQTT_CLIENT_ID') ?: 'mqtt-bridge',
        'keep_alive' => (int) (getenv('MQTT_KEEP_ALIVE') ?: 60),
    ],
    'labeling' => [
        // 購読トピックはこの書式から導出する（{label}/{device_id} → +/+）
        'topic_format' => getenv('BRIDGE_TOPIC_FORMAT') ?: '{label}/{device_id}',
        'time_field'   => getenv('BRIDGE_TIME_FIELD') ?: 'ts',
    ],
    'db' => [
        'dsn'      => getenv('DB_DSN') ?: 'mysql:host=127.0.0.1;port=3306;dbname=bridge;charset=utf8mb4',
        'user'     => getenv('DB_USER') ?: 'bridge',
        'password' => getenv('DB_PASSWORD') ?: '',
        'table'    => getenv('BRIDGE_DB_TABLE') ?: 'records',
        // "論理名=実カラム名" のカンマ区切り。起動時に識別子として検証する
        'columns'  => getenv('BRIDGE_DB_COLUMNS')
            ?: 'device_id=device_id,label=label,recorded_at=recorded_at,payload=payload',
    ],
    'buffer' => [
        'size'          => (int) (getenv('BUFFER_SIZE') ?: 50),
        'flush_seconds' => (int) (getenv('BUFFER_FLUSH_SECONDS') ?: 5),
    ],
];

$running = true;

$stop = static function (int $signo) use (&$running): void {
    fwrite(STDERR, "signal {$signo} received, shutting down\n");
    $running = false;
};
pcntl_signal(SIGTERM, $stop);
pcntl_signal(SIGINT, $stop);

// TODO: Worker を組み立ててループを回す
// $worker = new MqttBridge\Worker($config);
// $worker->run(fn (): bool => $running);
// $worker->shutdown(); // バッファをフラッシュしてから切断

exit(0);
