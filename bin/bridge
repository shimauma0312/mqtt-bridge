#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

$errors = [];

$env = static function (string $name) use (&$errors): string {
    $v = getenv($name);
    if ($v === false) {
        $errors[] = "missing env: {$name}";
        return '';
    }
    return $v;
};

$envInt = static function (string $name) use (&$errors): int {
    $v = getenv($name);
    if ($v === false) {
        $errors[] = "missing env: {$name}";
        return 0;
    }
    $i = filter_var($v, FILTER_VALIDATE_INT);
    if ($i === false) {
        $errors[] = "invalid int env: {$name}={$v}";
        return 0;
    }
    return $i;
};

$config = [
    'mqtt' => [
        'host'       => $env('MQTT_HOST'),
        'port'       => $envInt('MQTT_PORT'),
        'client_id'  => $env('MQTT_CLIENT_ID'),
        'keep_alive' => $envInt('MQTT_KEEP_ALIVE'),
    ],
    'labeling' => [
        // 購読トピックはこの書式から導出する（{label}/{device_id} → +/+）
        'topic_format' => $env('BRIDGE_TOPIC_FORMAT'),
        'time_field'   => $env('BRIDGE_TIME_FIELD'),
    ],
    'db' => [
        'dsn'      => $env('DB_DSN'),
        'user'     => $env('DB_USER'),
        'password' => $env('DB_PASSWORD'),
        'table'    => $env('BRIDGE_DB_TABLE'),
        // "論理名=実カラム名" のカンマ区切り。起動時に識別子として検証する
        'columns'  => $env('BRIDGE_DB_COLUMNS'),
    ],
    'buffer' => [
        'size'          => $envInt('BUFFER_SIZE'),
        'flush_seconds' => $envInt('BUFFER_FLUSH_SECONDS'),
    ],
];

if ($errors !== []) {
    foreach ($errors as $e) {
        fwrite(STDERR, $e . "\n");
    }
    exit(1);
}

$running = true;

$stop = function (int $signo) use (&$running): void {
    fwrite(STDERR, "signal {$signo} received, shutting down\n");
    $running = false;
};
pcntl_signal(SIGTERM, $stop);
pcntl_signal(SIGINT, $stop);

// TODO: Worker を組み立ててループを回す
// $worker = new MqttBridge\Worker($config);
// $worker->run(fn (): bool => $running);
// $worker->shutdown(); // バッファをフラッシュしてから切断

exit(0);
